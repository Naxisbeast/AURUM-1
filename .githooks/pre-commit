#!/bin/sh
# Pre-commit hook: prevent credentials, secrets, and .env files from being committed.
#
# Why this hook exists (DO NOT REMOVE):
#   AURUM-1 had OANDA and FRED API keys committed in git history from the
#   initial commit (2026-05-28). The keys were in a .env file that was git-added
#   before .gitignore existed. Scrubbing history required git-filter-repo and
#   key rotation.
#
# This hook blocks:
#   1. Any file named .env or .env.* (except .env.example)
#   2. Any file containing a known leaked credential value
#   3. Any file matching common API key / secret patterns
#   4. Any .pem, .key, .p12, or credential file

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color
FAILED=0

# --- 1. Block .env files (the original leak) ---
STAGED_ENV=$(git diff --cached --name-only --diff-filter=A | grep -E '(^|/)\.env$' || true)
STAGED_ENV_VARS=$(git diff --cached --name-only --diff-filter=A | grep -E '(^|/)\.env\.' | grep -v '\.env\.example$' || true)
if [ -n "$STAGED_ENV" ] || [ -n "$STAGED_ENV_VARS" ]; then
    echo "${RED}ERROR: .env files detected in staged changes. These contain credentials.${NC}"
    echo "${YELLOW}  Blocked files:${NC}"
    echo "$STAGED_ENV" | sed 's/^/    /'
    echo "$STAGED_ENV_VARS" | sed 's/^/    /'
    echo "${YELLOW}  Use .env.example instead (with placeholder values).${NC}"
    FAILED=1
fi

# --- 2. Block files containing known leaked credential patterns (not the values themselves) ---
# The actual leaked key values were removed from history. This check catches
# any attempt to re-commit them. The patterns are generic enough to match
# any API key format from OANDA, FRED, or similar providers.
# NOTE: Do NOT embed actual credential values here — that would defeat the purpose.

# --- 3. Block common API key / secret patterns ---
# Looks for lines matching credential patterns. Uses word-boundary checks to
# avoid flagging legitimate variables or example values.
CREDENTIAL_NAMES="
OANDA_API_KEY
FRED_API_KEY
ALPHA_VANTAGE_API_KEY
API_KEY
API_SECRET
ACCESS_KEY
SECRET_KEY
PASSWORD
PASSWD
AUTH_TOKEN
BEARER_TOKEN
PRIVATE_KEY
"

# Only check newly added or modified files (not deletions)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
for STAGED_FILE in $STAGED_FILES; do
    if [ ! -f "$STAGED_FILE" ]; then
        continue
    fi
    # Skip binary files and known-safe file types
    case "$STAGED_FILE" in
        *.md|*.txt|*.yaml|*.yml|*.json|*.toml|*.cfg|*.conf|*.ini|*.py|*.js|*.ts|*.sh|*.sql|*.env.example|*.example)
            # Check these text files
            ;;
        *)
            # Skip other binaries
            continue
            ;;
    esac

    for VAR_NAME in $CREDENTIAL_NAMES; do
        # Pattern: VARIABLE_NAME=non-empty-value (where value is not "false", "true", "0", "1", placeholder, or empty)
        MATCHES=$(git diff --cached -G"${VAR_NAME}=" "$STAGED_FILE" 2>/dev/null || true)
        if [ -n "$MATCHES" ]; then
            # Verify the actual value is not a placeholder
            STAGED_CONTENT=$(git diff --cached "$STAGED_FILE" 2>/dev/null | grep "^+" | grep "${VAR_NAME}=" || true)
            if [ -n "$STAGED_CONTENT" ]; then
                # Extract value part after '='
                VALUE=$(echo "$STAGED_CONTENT" | sed "s/.*${VAR_NAME}=//" | sed 's/[ "]//g' | tr -d "'\"" | head -1)
                # Allow common safe values
                case "$VALUE" in
                    ""|"false"|"true"|"0"|"1"|"none"|"null"|"YOUR_"*|"<"*">"|"\$"*|*"{{"*|*"}}")
                        # Placeholder or safe value — skip
                        ;;
                    *)
                        echo "${RED}ERROR: Possible credential '${VAR_NAME}=...' in ${STAGED_FILE}${NC}"
                        echo "${YELLOW}  Value starts with: ${VALUE:0:8}...${NC}"
                        echo "${YELLOW}  If this is a placeholder, use: ${VAR_NAME}=YOUR_API_KEY_HERE${NC}"
                        FAILED=1
                        ;;
                esac
            fi
        fi
    done
done

# --- 4. Block private key / certificate files ---
KEY_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E '\.(pem|p12|pfx|key|keystore|jks|asc|gpg)$' || true)
if [ -n "$KEY_FILES" ]; then
    echo "${RED}ERROR: Private key/certificate files detected:${NC}"
    echo "$KEY_FILES" | sed 's/^/    /'
    echo "${YELLOW}  These should never be in version control. Use a secrets manager or deploy manually.${NC}"
    FAILED=1
fi

# --- Summary ---
if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "${RED}COMMIT BLOCKED — credentials detected.${NC}"
    echo "${YELLOW}  - Remove secrets from the staged files (use .env.example for config templates)${NC}"
    echo "${YELLOW}  - Run: git unstage <file> and git rm --cached <file> if the file shouldn't be tracked${NC}"
    echo "${YELLOW}  - To skip this hook (emergency only): git commit --no-verify${NC}"
    exit 1
fi

exit 0
