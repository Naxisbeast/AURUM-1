[Unit]
Description=AURUM-1 D4 shadow — BUY+SELL Donchian + 2R exit, no filters
Documentation=https://github.com/Naxisbeast/AURUM-1
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aurum1
Group=aurum1
WorkingDirectory=/opt/aurum1
Environment=OANDA_ENV=practice
Environment=ALLOW_OANDA_ORDERS=false
Environment=ALLOW_LIVE_TRADING=false
ExecStart=/opt/aurum1/.venv/bin/python /opt/aurum1/scripts/shadow/forward_shadow_donchian_d4.py --json
