[Unit]
Description=AURUM-1 forward shadow Donchian research service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aurum1
EnvironmentFile=/opt/aurum1/.env
Environment=ALLOW_OANDA_ORDERS=false
Environment=ALLOW_LIVE_TRADING=false
Environment=OANDA_ENV=practice
# DEPLOYMENT REQUIRED:
# Replace <FORWARD_SHADOW_START_DATE_UTC> with the frozen UTC start timestamp
# chosen at deployment time, for example an ISO-8601 value ending in Z.
# Do not leave this placeholder in the installed service.
ExecStart=/opt/aurum1/.venv/bin/python /opt/aurum1/scripts/shadow/forward_shadow_donchian.py service --start-date <FORWARD_SHADOW_START_DATE_UTC>
Restart=on-failure
RestartSec=30
User=aurum1
Group=aurum1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/aurum1/logs /opt/aurum1/reports /opt/aurum1/aurum1/data /opt/aurum1/backups

[Install]
WantedBy=multi-user.target
