[Unit]
Description=AURUM-1 ML model retraining
Documentation=https://github.com/Naxisbeast/AURUM-1
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aurum1
Group=aurum1
WorkingDirectory=/opt/aurum1
ExecStart=/opt/aurum1/.venv/bin/python /opt/aurum1/scripts/train_ml_models.py
