# AURUM-1 environment configuration (placeholders only — never commit real values).
#
# Copy to `.env` and fill in values. The pre-commit hook blocks committing any
# `.env` file and any non-placeholder credential value.

# --- OANDA (practice) ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# --- Safety interlocks (leave false for paper trading only) ---
ALLOW_OANDA_ORDERS=false
ALLOW_LIVE_TRADING=false

# --- Optional data providers ---
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Optional operational alerts ---
# ALERT_WEBHOOK_URL=https://hooks.example.com/your-webhook

# --- Optional: allow running the forward shadow `service` mode outside a venv ---
# AURUM1_ALLOW_SYSTEM_PYTHON=false
